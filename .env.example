# Upstox 1-Year Analytics Token (or standard API Bearer token)
UPSTOX_ACCESS_TOKEN=your_upstox_analytics_or_access_token_here
# Long random secret for manual POST /api/eod-sync (leave empty to disable manual syncs)
EOD_SYNC_TOKEN=

# AI Provider Keys (Configure one or more; hot-swappable in UI)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM configuration
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini/gemini-3.8-flash
